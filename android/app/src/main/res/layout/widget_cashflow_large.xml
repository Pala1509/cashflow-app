<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Marca: CF + nombre -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="CashFlow"
            android:textColor="#9A9A9E"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Etiqueta + balance -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Balance total"
        android:textColor="#9A9A9E"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="$0"
        android:textColor="#F5F5F3"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Botones rápidos: Ingreso / Egreso -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_ingreso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_ingreso"
            android:gravity="center"
            android:padding="10dp"
            android:text="+ Ingreso"
            android:textColor="#C6FF4D"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_egreso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_egreso"
            android:gravity="center"
            android:padding="10dp"
            android:text="- Egreso"
            android:textColor="#FF7A6E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Anotar con voz (abre VozActivity, sin abrir la app) -->
        <ImageView
            android:id="@+id/widget_btn_voz"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_voz"
            android:contentDescription="Anotar con voz"
            android:padding="9dp"
            android:src="@drawable/ic_mic" />
    </LinearLayout>

    <!-- Separador — un View genérico no está soportado por RemoteViews
    (causaba "No se pudo agregar el widget" al inflar), un TextView vacío
    con fondo sí es una de las vistas permitidas. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:background="#2C2C2F" />

    <!-- Ingresos/egresos del mes — lo "de más" que pidió el usuario,
    aparte de solo la lista de movimientos. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresos del mes"
                android:textColor="#9A9A9E"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_ingresos_mes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0"
                android:textColor="#C6FF4D"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Egresos del mes"
                android:textColor="#9A9A9E"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_egresos_mes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0"
                android:textColor="#FF7A6E"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Separador -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="#2C2C2F" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Movimientos recientes"
        android:textColor="#9A9A9E"
        android:textSize="9.5sp" />

    <!-- Hasta 4 líneas de movimientos recientes — ya vienen formateadas
    desde React (ver useNotificacionesEngine.ts), el widget solo las pinta.
    Las que no tengan dato se ocultan (visibility=gone) en el Provider. -->
    <TextView
        android:id="@+id/widget_reciente_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#D8D8D6"
        android:textSize="11.5sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_reciente_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#D8D8D6"
        android:textSize="11.5sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_reciente_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#D8D8D6"
        android:textSize="11.5sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_reciente_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#D8D8D6"
        android:textSize="11.5sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_reciente_vacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Aún no tienes movimientos."
        android:textColor="#5A5A5E"
        android:textSize="11sp" />
</LinearLayout>
