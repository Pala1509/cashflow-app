<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Marca: ícono real de la app + nombre -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="CashFlow"
            android:textColor="#9A9A9E"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Etiqueta + balance -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Balance total"
        android:textColor="#9A9A9E"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="$0"
        android:textColor="#F5F5F3"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Botones rápidos: Ingreso / Egreso -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_ingreso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_ingreso"
            android:gravity="center"
            android:padding="10dp"
            android:text="+ Ingreso"
            android:textColor="#C6FF4D"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_egreso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_egreso"
            android:gravity="center"
            android:padding="10dp"
            android:text="- Egreso"
            android:textColor="#FF7A6E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Anotar con voz (abre VozActivity, sin abrir la app) -->
        <ImageView
            android:id="@+id/widget_btn_voz"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_voz"
            android:contentDescription="Anotar con voz"
            android:padding="9dp"
            android:src="@drawable/ic_mic" />
    </LinearLayout>

    <!-- Separador -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="7dp"
        android:background="#2C2C2F" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:text="Movimientos recientes"
        android:textColor="#9A9A9E"
        android:textSize="9.5sp" />

    <!-- Hasta 3 movimientos recientes — un poco menos que el widget
    grande (acá hay menos espacio). Coloreados según ingreso/egreso/
    transferencia por CashFlowWidgetProvider.pintarLineaReciente(). -->
    <TextView
        android:id="@+id/widget_reciente_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#D8D8D6"
        android:textSize="10.5sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_reciente_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#D8D8D6"
        android:textSize="10.5sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_reciente_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#D8D8D6"
        android:textSize="10.5sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_reciente_vacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Aún no tienes movimientos."
        android:textColor="#5A5A5E"
        android:textSize="10sp" />
</LinearLayout>
