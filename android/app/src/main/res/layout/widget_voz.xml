<?xml version="1.0" encoding="utf-8"?>
<!-- Widget pequeño (1x1): solo el micrófono para anotar con voz. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_voz_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp">

    <ImageView
        android:id="@+id/widget_voz_btn"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_voz_background"
        android:contentDescription="Anotar con voz"
        android:padding="14dp"
        android:src="@drawable/ic_mic" />
</FrameLayout>
